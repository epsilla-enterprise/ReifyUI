{
  "name": "reifyui",
  "version": "0.6.1",
  "description": "The open-source rendering & interaction layer for agentic applications. Stream and render any agent's output as polished, application-native UI \u2014 model-agnostic, framework-agnostic, design-system-native. The foundation for building generative-UI and agent products.",
  "keywords": [
    "react",
    "generative-ui",
    "genui",
    "agentic",
    "agent",
    "copilot",
    "assistant",
    "ai",
    "llm",
    "streaming",
    "tool-calling",
    "components"
  ],
  "license": "MIT",
  "author": "Epsilla",
  "homepage": "https://github.com/epsilla-enterprise/ReifyUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epsilla-enterprise/ReifyUI.git"
  },
  "bugs": {
    "url": "https://github.com/epsilla-enterprise/ReifyUI/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./slides": {
      "types": "./dist/slides.d.ts",
      "import": "./dist/slides.js",
      "require": "./dist/slides.cjs"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js",
      "require": "./dist/harness.cjs"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "echarts": "^5 || ^6",
    "highlight.js": "^11",
    "mermaid": "^10 || ^11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
