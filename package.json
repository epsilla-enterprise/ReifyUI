{
  "name": "reifyui",
  "version": "0.13.4",
  "description": "The open-source rendering & interaction layer for agentic applications. Stream and render any agent's output as polished, application-native UI — model-agnostic, framework-agnostic, design-system-native. The foundation for building generative-UI and agent products.",
  "keywords": [
    "react",
    "generative-ui",
    "genui",
    "agentic",
    "agent",
    "copilot",
    "assistant",
    "ai",
    "llm",
    "streaming",
    "tool-calling",
    "components"
  ],
  "license": "MIT",
  "author": "Epsilla",
  "homepage": "https://github.com/epsilla-enterprise/ReifyUI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epsilla-enterprise/ReifyUI.git"
  },
  "bugs": {
    "url": "https://github.com/epsilla-enterprise/ReifyUI/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./slides": {
      "types": "./dist/slides.d.ts",
      "import": "./dist/slides.js",
      "require": "./dist/slides.cjs"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js",
      "require": "./dist/harness.cjs"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js",
      "require": "./dist/chart.cjs"
    },
    "./collab": {
      "types": "./dist/collab.d.ts",
      "import": "./dist/collab.js",
      "require": "./dist/collab.cjs"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js",
      "require": "./dist/sheet.cjs"
    },
    "./sheet-doc": {
      "types": "./dist/sheet-doc.d.ts",
      "import": "./dist/sheet-doc.js",
      "require": "./dist/sheet-doc.cjs"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js",
      "require": "./dist/graph.cjs"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "slides": [
        "dist/slides.d.ts"
      ],
      "harness": [
        "dist/harness.d.ts"
      ],
      "chart": [
        "dist/chart.d.ts"
      ],
      "collab": [
        "dist/collab.d.ts"
      ],
      "sheet": [
        "dist/sheet.d.ts"
      ],
      "sheet-doc": [
        "dist/sheet-doc.d.ts"
      ],
      "graph": [
        "dist/graph.d.ts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "echarts": "^5 || ^6",
    "highlight.js": "^11",
    "mermaid": "^10 || ^11",
    "react": ">=18",
    "react-dom": ">=18",
    "react-file-icon": "^1",
    "yjs": "^13.6",
    "@hocuspocus/provider": "^2.13",
    "lucide-react": ">=0.400"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "react-file-icon": {
      "optional": true
    },
    "yjs": {
      "optional": true
    },
    "@hocuspocus/provider": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
